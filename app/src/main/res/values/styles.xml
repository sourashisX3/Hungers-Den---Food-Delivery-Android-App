<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Button Styles -->
    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/orangebuttongradient</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:fontFamily">@font/cabalbold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height_large</item>
        <item name="android:paddingStart">@dimen/spacing_medium</item>
        <item name="android:paddingEnd">@dimen/spacing_medium</item>
    </style>

    <style name="SecondaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/whitebutton</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/spacing_medium</item>
        <item name="android:paddingEnd">@dimen/spacing_medium</item>
    </style>

    <!-- Text Styles -->
    <style name="HeadlineText">
        <item name="android:textSize">@dimen/text_size_headline</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:fontFamily">@font/cabalbold</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TitleText">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:fontFamily">@font/cabalbold</item>
    </style>

    <style name="SubtitleText">
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:fontFamily">@font/cabalbold</item>
    </style>

    <style name="BodyText">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:fontFamily">@font/lato</item>
    </style>

    <style name="CaptionText">
        <item name="android:textSize">@dimen/text_size_normal</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:fontFamily">@font/lato</item>
    </style>

    <!-- Card Styles -->
    <style name="CardViewStyle">
        <item name="cardBackgroundColor">@color/cardBackground</item>
        <item name="cardCornerRadius">@dimen/card_radius_normal</item>
        <item name="cardElevation">@dimen/elevation_normal</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <!-- EditText Styles -->
    <style name="EditTextStyle">
        <item name="android:background">@drawable/edittextshape</item>
        <item name="android:padding">@dimen/spacing_medium</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textHint</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:fontFamily">@font/lato</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <!-- SearchView Styles -->
    <style name="SearchViewStyle" parent="Widget.AppCompat.SearchView">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textHint</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:fontFamily">@font/lato</item>
        <item name="queryBackground">@android:color/transparent</item>
        <item name="submitBackground">@android:color/transparent</item>
    </style>
</resources>
